<?xml version="1.0" encoding="UTF-8"?>
<!--
  Week 13 (TP-X04): one parameterised workload plan that covers every brief
  section 6 workload profile. Five stages run one after another, each with a
  target rate set by a Constant Throughput Timer.

  -Jmode=open is the true open-loop mode: threads only submit and never poll, so
  arrivals do not depend on how fast orders finish. -Jmode=poll (the default)
  polls each accepted order to a terminal state before the thread submits again,
  so it is closed-loop and rateN is only a ceiling (docs/workload-profiles.md).

  Properties (-J):
    -Jhost=<host>   -Jport=<port>   -Jpath=/api/orders | /api/c1/orders
    -JproductsFile=<csv>   (CSV Data Set, recycle on, all threads; one "productId" per row)
    per stage N (1..5):  -JthreadsN=<n>  -JrateN=<r/s>  -JdurationN=<seconds>
    -Jloops1=<n>   stage 1 loop count (default -1 = run for duration1)
    -Jmode=poll|open   default poll; open never polls

  Stages run one after another via ThreadGroup.delay = the sum of the previous
  stages' durations (__intSum), so the threads all start at t=0 but stage N
  waits for stages 1..N-1 to finish. A stage with threadsN=0 is skipped (set its
  durationN=0 too so it adds no delay). Stage 1's LoopController.loops is
  ${loops1}: -1 (default) means "run for duration1 seconds"; a positive loops1
  runs exactly that many iterations per thread, so with the other stages 0 the
  exact total is threads1 x loops1 (used for the below/equal/above-inventory
  profiles).

  Every POST carries a fresh Idempotency-Key (UserParameters per_iteration, so it
  also resets orderId/orderState/pollCount for the next iteration). Built-in
  elements only (no JSR223/Groovy), so the plan runs on Java 17 and Java 25. The
  POST sampler label contains "submit"; the GET poll label contains "poll", which
  scripts/extract-run-metrics.ps1 uses to classify rows.

  For /api/orders the response carries an order id, so a bounded poll-until-terminal
  loop follows (GET /api/orders/{id} until Completed/Rejected, at most 40 polls).
  For /api/c1/orders (C1 baseline) the response has no id field, the extractor
  falls back to NO_ORDER, and the IfController skips polling entirely.

  429 (Nginx gateway) and 503 (admission) are EXPECTED overload responses, not
  errors: the submit sampler asserts the response code is 2xx, 429 or 503.
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Week 13 workload matrix">
      <stringProp name="TestPlan.comments">One parameterised plan for every brief section 6 profile: steady, ramp-up, spike, sustained overload + recovery, hot product, skewed products, below/equal/above inventory. 429 and 503 are expected overload responses.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>
      <!-- One shared CSV Data Set: every stage reads the same product list, all
           threads share the cursor, recycling when the list is exhausted (a
           single-product CSV is therefore just that product forever). -->
      <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Products (CSV)" enabled="true">
        <stringProp name="delimiter">,</stringProp>
        <stringProp name="fileEncoding">UTF-8</stringProp>
        <stringProp name="filename">${__P(productsFile,products.csv)}</stringProp>
        <boolProp name="ignoreFirstLine">true</boolProp>
        <boolProp name="quotedData">false</boolProp>
        <boolProp name="recycle">true</boolProp>
        <stringProp name="shareMode">shareMode.all</stringProp>
        <stringProp name="stopThread">false</stringProp>
        <stringProp name="variableNames">productId</stringProp>
      </CSVDataSet>
      <hashTree/>

      <!-- ===================== Stage 1 ===================== -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Stage 1">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${__P(loops1,-1)}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(threads1,0)}</stringProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(duration1,0)}</stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <ConstantThroughputTimer guiclass="TestBeanGUI" testclass="ConstantThroughputTimer" testname="Stage 1 rate (r/s to /min)" enabled="true">
          <stringProp name="calcMode">2</stringProp>
          <stringProp name="throughput">${__jexl3(${__P(rate1,0)} * 60.0)}</stringProp>
        </ConstantThroughputTimer>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="submit-stage1" enabled="true">
          <stringProp name="HTTPSampler.domain">${__P(host,localhost)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(port,80)}</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.path">${__P(path,/api/orders)}</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;productId&quot;: &quot;${productId}&quot;, &quot;quantity&quot;: 1}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <UserParameters guiclass="UserParametersGui" testclass="UserParameters" testname="Per-iteration variables" enabled="true">
            <collectionProp name="UserParameters.names">
              <stringProp name="idempotencyKey">idempotencyKey</stringProp>
              <stringProp name="orderId">orderId</stringProp>
              <stringProp name="orderState">orderState</stringProp>
              <stringProp name="pollCount">pollCount</stringProp>
            </collectionProp>
            <collectionProp name="UserParameters.thread_values">
              <collectionProp name="0">
                <stringProp name="0">${__UUID()}</stringProp>
                <stringProp name="1"></stringProp>
                <stringProp name="2"></stringProp>
                <stringProp name="3">0</stringProp>
              </collectionProp>
            </collectionProp>
            <boolProp name="UserParameters.per_iteration">true</boolProp>
          </UserParameters>
          <hashTree/>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Headers" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Idempotency-Key</stringProp>
                <stringProp name="Header.value">${idempotencyKey}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="2xx, 429 or 503 are acceptable" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="1">^(2\d\d|429|503)$</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Expected 2xx, 429 (gateway) or 503 (admission); any other non-2xx is an error</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="Extract order id" enabled="true">
            <stringProp name="RegexExtractor.useHeaders">false</stringProp>
            <stringProp name="RegexExtractor.refname">orderId</stringProp>
            <stringProp name="RegexExtractor.regex">&quot;id&quot;:&quot;([^&quot;]+)&quot;</stringProp>
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            <stringProp name="RegexExtractor.default">NO_ORDER</stringProp>
            <stringProp name="RegexExtractor.match_number">1</stringProp>
          </RegexExtractor>
          <hashTree/>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Poll only when an order id was returned and mode is not open" enabled="true">
          <stringProp name="IfController.condition">${__jexl3("${orderId}" != "NO_ORDER" &amp;&amp; "${__P(mode,poll)}" != "open")}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="Poll until terminal" enabled="true">
            <stringProp name="WhileController.condition">${__jexl3("${orderState}" != "Completed" &amp;&amp; "${orderState}" != "Rejected" &amp;&amp; ${pollCount} &lt; 40)}</stringProp>
          </WhileController>
          <hashTree>
            <CounterConfig guiclass="CounterConfigGui" testclass="CounterConfig" testname="Poll counter" enabled="true">
              <stringProp name="CounterConfig.start">1</stringProp>
              <stringProp name="CounterConfig.end">40</stringProp>
              <stringProp name="CounterConfig.incr">1</stringProp>
              <stringProp name="CounterConfig.name">pollCount</stringProp>
              <boolProp name="CounterConfig.per_user">true</boolProp>
            </CounterConfig>
            <hashTree/>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="poll-stage1" enabled="true">
              <stringProp name="HTTPSampler.domain">${__P(host,localhost)}</stringProp>
              <stringProp name="HTTPSampler.port">${__P(port,80)}</stringProp>
              <stringProp name="HTTPSampler.protocol">http</stringProp>
              <stringProp name="HTTPSampler.path">/api/orders/${orderId}</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                <collectionProp name="Arguments.arguments"/>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Poll is 200" enabled="true">
                <collectionProp name="Asserion.test_strings">
                  <stringProp name="49586">200</stringProp>
                </collectionProp>
                <stringProp name="Assertion.custom_message">Expected HTTP 200 while polling an accepted order</stringProp>
                <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                <boolProp name="Assertion.assume_success">false</boolProp>
                <intProp name="Assertion.test_type">8</intProp>
              </ResponseAssertion>
              <hashTree/>
              <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="Extract order state" enabled="true">
                <stringProp name="RegexExtractor.useHeaders">false</stringProp>
                <stringProp name="RegexExtractor.refname">orderState</stringProp>
                <stringProp name="RegexExtractor.regex">&quot;state&quot;:&quot;([^&quot;]+)&quot;</stringProp>
                <stringProp name="RegexExtractor.template">$1$</stringProp>
                <stringProp name="RegexExtractor.default">NOT_FOUND</stringProp>
                <stringProp name="RegexExtractor.match_number">1</stringProp>
              </RegexExtractor>
              <hashTree/>
            </hashTree>
            <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Poll pause" enabled="true">
              <stringProp name="ConstantTimer.delay">500</stringProp>
            </ConstantTimer>
            <hashTree/>
          </hashTree>
        </hashTree>
      </hashTree>

      <!-- ===================== Stage 2 ===================== -->
