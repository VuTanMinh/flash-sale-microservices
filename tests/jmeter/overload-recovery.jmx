      </ThreadGroup>
      <hashTree>
        <ConstantThroughputTimer guiclass="TestBeanGUI" testclass="ConstantThroughputTimer" testname="Recovery rate (r/s to /min)" enabled="true">
          <stringProp name="calcMode">2</stringProp>
          <stringProp name="throughput">${__jexl3(${__P(recoveryRate,3)} * 60.0)}</stringProp>
