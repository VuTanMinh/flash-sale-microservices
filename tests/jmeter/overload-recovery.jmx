<?xml version="1.0" encoding="UTF-8"?>
<!--
  Week 12 box 4 (TP-L04): overload, drain and recovery in one run, three phases
  run in sequence (TestPlan.serialize_threadgroups = true):

    Phase 1  baseline   submit at baselineRate  r/s for baselineDuration  s
    Phase 2  overload   submit at overloadRate  r/s for overloadDuration  s
    Phase 3  recovery   submit at recoveryRate  r/s for recoveryDuration  s

  Each phase is an OPEN-LOOP target rate (a Constant Throughput Timer paces the
  arrivals independently of response time, with enough threads so the timer is
  never the bottleneck). Run it with properties (-J):

    -Jhost=<backend host>   -Jport=<nginx port>   -Jproduct=<product id>
    -JbaselineRate=3   -JoverloadRate=60   -JrecoveryRate=3   (requests/second)
    -JbaselineDuration=30 -JoverloadDuration=60 -JrecoveryDuration=60  (seconds)

  Every POST carries a unique Idempotency-Key: a User Parameters pre-processor
  sets idempotencyKey = ${__UUID()} once per iteration (built-in elements only,
  so the plan runs on both Java 17 and Java 25), and the header sends
  ${idempotencyKey}. Run with -Jsample_variables=idempotencyKey so each request's
  key lands in the JTL and the verifier can check refused keys against the order
  table. The POST sampler label contains "submit"; the GET poll
  sampler label contains "poll", which scripts/extract-run-metrics.ps1 uses to
  classify rows. Labels also carry the phase name ("submit-baseline",
  "submit-overload", "submit-recovery", ...) so the verifier can compute
  per-phase numbers from the JTL.

  Polling is a BOUNDED sample of accepted orders: only when the submit index is
  every 10th AND the response carried an order id (a 429/503 has no id), poll
  the order exactly 3 times. It is never an unbounded poll-until-terminal loop.

  429 (Nginx gateway) and 503 (admission) are EXPECTED overload responses, not
  errors: the submit sampler asserts the response code is 2xx, 429 or 503, and
  any other non-2xx (4xx other than 429, 5xx other than 503, connection error)
  fails the sample.
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Overload, drain and recovery">
      <stringProp name="TestPlan.comments">Three sequential open-loop phases (baseline / overload / recovery). 429 and 503 are expected overload responses; any other non-2xx is an error.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>

      <!-- ===================== Phase 1: baseline ===================== -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Phase 1: baseline">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <boolProp name="LoopController.continue_forever">true</boolProp>
          <stringProp name="LoopController.loops">-1</stringProp>
        </elementProp>
        <intProp name="ThreadGroup.num_threads">100</intProp>
        <intProp name="ThreadGroup.ramp_time">5</intProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(baselineDuration,30)}</stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <ConstantThroughputTimer guiclass="TestBeanGUI" testclass="ConstantThroughputTimer" testname="Baseline rate (r/s to /min)" enabled="true">
          <stringProp name="calcMode">2</stringProp>
          <stringProp name="throughput">${__jexl3(${__P(baselineRate,3)} * 60.0)}</stringProp>
        </ConstantThroughputTimer>
        <hashTree/>
        <CounterConfig guiclass="CounterConfigGui" testclass="CounterConfig" testname="Submit index (shared)" enabled="true">
          <stringProp name="CounterConfig.start">0</stringProp>
          <stringProp name="CounterConfig.end">1000000000</stringProp>
          <stringProp name="CounterConfig.incr">1</stringProp>
          <stringProp name="CounterConfig.name">submitIndex</stringProp>
          <boolProp name="CounterConfig.per_user">false</boolProp>
        </CounterConfig>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="submit-baseline" enabled="true">
          <stringProp name="HTTPSampler.domain">${__P(host,localhost)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(port,80)}</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.path">/api/orders</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;productId&quot;: &quot;${__P(product,flash-product-1)}&quot;, &quot;quantity&quot;: 1}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <UserParameters guiclass="UserParametersGui" testclass="UserParameters" testname="Set Idempotency-Key" enabled="true">
            <collectionProp name="UserParameters.names">
              <stringProp name="idempotencyKey">idempotencyKey</stringProp>
            </collectionProp>
            <collectionProp name="UserParameters.thread_values">
              <collectionProp name="0">
                <stringProp name="0">${__UUID()}</stringProp>
              </collectionProp>
            </collectionProp>
            <boolProp name="UserParameters.per_iteration">true</boolProp>
          </UserParameters>
          <hashTree/>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Headers" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Idempotency-Key</stringProp>
                <stringProp name="Header.value">${idempotencyKey}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="2xx, 429 or 503 are acceptable" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="1">^(2\d\d|429|503)$</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Expected 2xx, 429 (gateway) or 503 (admission); any other non-2xx is an error</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="Extract order id" enabled="true">
            <stringProp name="RegexExtractor.useHeaders">false</stringProp>
            <stringProp name="RegexExtractor.refname">orderId</stringProp>
            <stringProp name="RegexExtractor.regex">&quot;id&quot;:&quot;([^&quot;]+)&quot;</stringProp>
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            <stringProp name="RegexExtractor.default">NO_ORDER</stringProp>
            <stringProp name="RegexExtractor.match_number">1</stringProp>
          </RegexExtractor>
          <hashTree/>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Poll every 10th accepted order" enabled="true">
          <stringProp name="IfController.condition">${__jexl3(${submitIndex} % 10 == 0 &amp;&amp; "${orderId}" != "NO_ORDER")}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="Poll 3 times" enabled="true">
            <boolProp name="LoopController.continue_forever">false</boolProp>
            <stringProp name="LoopController.loops">3</stringProp>
          </LoopController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="poll-baseline" enabled="true">
              <stringProp name="HTTPSampler.domain">${__P(host,localhost)}</stringProp>
              <stringProp name="HTTPSampler.port">${__P(port,80)}</stringProp>
              <stringProp name="HTTPSampler.protocol">http</stringProp>
              <stringProp name="HTTPSampler.path">/api/orders/${orderId}</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                <collectionProp name="Arguments.arguments"/>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Poll is 200" enabled="true">
                <collectionProp name="Asserion.test_strings">
                  <stringProp name="49586">200</stringProp>
                </collectionProp>
                <stringProp name="Assertion.custom_message">Expected HTTP 200 while polling an accepted order</stringProp>
                <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                <boolProp name="Assertion.assume_success">false</boolProp>
                <intProp name="Assertion.test_type">8</intProp>
              </ResponseAssertion>
              <hashTree/>
            </hashTree>
            <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Poll pause" enabled="true">
              <stringProp name="ConstantTimer.delay">200</stringProp>
            </ConstantTimer>
            <hashTree/>
          </hashTree>
        </hashTree>
      </hashTree>

      <!-- ===================== Phase 2: overload ===================== -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Phase 2: overload">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <boolProp name="LoopController.continue_forever">true</boolProp>
          <stringProp name="LoopController.loops">-1</stringProp>
        </elementProp>
