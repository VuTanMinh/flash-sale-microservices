# Example for infra/ec2.env (the real file is git-ignored: *.env).
#
#   cp infra/ec2.env.example infra/ec2.env
#   # then edit infra/ec2.env and replace every CHANGE_ME with a real value
#
# All values below are consumed by `docker compose --env-file infra/ec2.env -f
# infra/docker-compose.ec2.yml ...`. The ${...} placeholders in that Compose
# file interpolate from here. Nothing in this example is a real secret.

# --- PostgreSQL bootstrap (admin) ---
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_ADMIN_PASSWORD

# --- PostgreSQL server connection limit (C4 replicas) ---
# Order pool 60 + Inventory pool 30 per replica: 1 replica = 90, 4 replicas =
# 60 + 4x30 = 180, plus ~3 reserved = 183. 200 leaves 17 of headroom. The pool
# sizes themselves are unchanged; only the server limit moves up (see
# infra/docker-compose.ec2.yml postgres.command).
PG_MAX_CONNECTIONS=200

# --- RabbitMQ broker ---
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD

# --- Service database accounts ---
# REQUIRED, real and distinct. The EC2 stack overrides the dev values that
# infra/initdb/01-create-service-roles.sql sets with these (see
# infra/initdb-ec2/02-service-roles-passwords.sh). Generate each on the backend:
#   openssl rand -base64 24
ORDER_SERVICE_PASSWORD=CHANGE_ME_ORDER_SERVICE_PASSWORD
INVENTORY_SERVICE_PASSWORD=CHANGE_ME_INVENTORY_SERVICE_PASSWORD

# --- C3 switches (docs/load-shedding.md). Off by default == C2 behaviour. ---
# Order Service application admission:
ADMISSION_ENABLED=false
ADMISSION_MAX_CONCURRENT_NEW_ORDERS=64
ADMISSION_MAX_OUTBOX_BACKLOG=0
# Unfinished orders allowed before a new order gets 503 reason=inflight (0 = off):
ADMISSION_MAX_IN_FLIGHT_ORDERS=0
# Process Worker: orders processed at the same time (each still takes the fixed delay):
PROCESSING_MAX_CONCURRENCY=1
# Nginx gateway rate limit (shared POST /api/orders and POST /api/c1/orders bucket):
ORDER_RATE=200r/s
ORDER_BURST=100
