erDiagram
    orders ||--o{ outbox_events : "OrderId (logical, same transaction)"
    orders {
        uuid Id PK
        text IdempotencyKey UK "client Idempotency-Key header"
        text ProductId
        integer Quantity
        text State "enum stored as text"
        text CorrelationId "indexed, not unique"
        timestamp RequestAcceptedAt
        timestamp ConfirmedOrRejectedAt "nullable"
        timestamp CompletedAt "nullable"
    }
    outbox_events {
        uuid Id PK "row id; the event MessageId is a separate value inside Payload"
        uuid OrderId "logical ref to orders.Id, no FK, not unique"
        text EventType "e.g. OrderPlaced"
        jsonb Payload
        boolean Published "indexed; true only after publisher confirm"
        timestamp CreatedAt
        timestamp PublishedAt "nullable"
    }
    processed_messages {
        uuid Id PK
        uuid MessageId UK "Inbox: one row per consumed broker message"
        text MessageType
        timestamp ProcessedAt
    }
    order_status_history {
        uuid Id PK
        bigint Seq "identity; insertion order, the read ordering key"
        uuid OrderId "logical ref to orders.Id, no FK, indexed"
        text FromState "nullable; null for the creation row"
        text ToState
        uuid MessageId "nullable; the triggering event's MessageId"
        timestamp At
        boolean Implied "true only for an implied Processing row"
    }
