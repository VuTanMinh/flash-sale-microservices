# .NET / Visual Studio (matches GitHub's "VisualStudio" .gitignore template,
# picked in Step 2.1 — added here since the repo was created without one)
bin/
obj/
.vs/
*.user
*.suo

# ABP CLI
*.rej
**/node_modules/
**/wwwroot/libs/
**/Logs/*.txt
**/appsettings.secrets.json
*.pfx

# Terraform (used by setup-week1.ps1 for local infra provisioning)
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!environments/*.tfvars.example
crash.log
crash.*.log

# LaTeX build artifacts (report/report.tex)
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.fls
report/*.fdb_latexmk
report/*.synctex.gz
report/*.pdf

# JMeter run artifacts (the Step 3.5 smoke-test .jtl is intentionally
# committed as report evidence -- this only excludes JMeter's own verbose
# run log and future large load-test result dumps)
tests/jmeter/results/*.log
tests/jmeter/*-results/

# Local tool config — not project source
.claude/

# OS
Thumbs.db
.DS_Store

#Powershell script
setup.ps1
setup-week1.ps1

# Markdown docs stay local-only from here on -- planning/checklist/design
# docs live in the working tree for reference (report/report.tex is what
# actually gets submitted), not in the pushed repo. Only the root README
# is tracked; nested README.md files (e.g. ABP-scaffolded ones under src/)
# are excluded too since the exception below is anchored to repo root.
*.md
!/README.md
