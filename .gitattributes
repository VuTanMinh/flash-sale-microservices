# Shell scripts run inside Linux containers (Postgres init on EC2): keep LF on every checkout.
*.sh text eol=lf

# Generated Results tables and data (report/figures/analyze_official.py): check them out
# with the line endings the script writes, so a rerun on a fresh clone changes no file.
report/figures/official/*.tex text eol=lf
report/figures/official/*.csv text eol=crlf
